# Copy to .env.local for local development, and set the same values in the
# Vercel project settings (Production and Preview). Never commit real values.
# Variables starting with NEXT_PUBLIC_ are built into client code and are public.

# ── Enquiry form delivery (server only) ──────────────────────────────────────
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown on enquiry emails. The domain must be verified in Resend,
# e.g. "Eigensu website <website@eigensu.in>".
ENQUIRY_FROM=
# Where enquiry emails go. Comma-separate several addresses.
ENQUIRY_TO=contact@eigensu.in
# Optional Google Sheet webhook (e.g. an Apps Script web app URL). Leave empty to skip.
SHEET_WEBHOOK_URL=
# Optional shared secret sent with each webhook call, so the script can reject other callers.
SHEET_WEBHOOK_SECRET=

# ── Calls to action (public) ─────────────────────────────────────────────────
# Demo booking link (Cal.com / Calendly). When empty, "Book a demo" opens the enquiry form.
NEXT_PUBLIC_DEMO_URL=
# WhatsApp number with country code, digits only, e.g. 919876543210.
# When empty, the "Message us on WhatsApp" buttons are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Search engine verification (public meta tags) ────────────────────────────
# Google Search Console "HTML tag" method: the content="" value only.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools "meta tag" method (msvalidate.01): the content="" value only.
BING_SITE_VERIFICATION=

# ── Analytics (public) ───────────────────────────────────────────────────────
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Tag Manager loads only in
# production builds, and only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GTM_ID=
